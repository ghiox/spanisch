{
  "id": "serestar",
  "title": "ser vs. estar",
  "rule": {
    "lines": [
      "ser = Eigenschaft, Identität, Beruf, Herkunft, Uhrzeit: soy, eres, es, somos, sois, son.",
      "estar = Ort, Zustand, Befinden: estoy, estás, está, estamos, estáis, están.",
      "estar + Gerundio = gerade jetzt: Estoy comiendo.",
      "Bedeutungswechsel: es aburrido (langweilig) / está aburrido (gelangweilt).",
      "Bedeutungswechsel: es listo (schlau) / está listo (bereit)."
    ],
    "examples": [
      { "es": "Marta es de Madrid.", "de": "Marta ist aus Madrid." },
      { "es": "El libro está en la mesa.", "de": "Das Buch liegt auf dem Tisch." },
      { "es": "Hoy estamos muy cansados.", "de": "Heute sind wir sehr müde." },
      { "es": "Son las ocho de la mañana.", "de": "Es ist acht Uhr morgens." }
    ]
  },
