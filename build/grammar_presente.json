  "title": "Präsens",
  "rule": {
    "lines": [
      "Die Endung sagt, wer handelt — das Pronomen kann weg: -o (yo), -as/-es (tú), -a/-e (él), -amos/-emos/-imos (nosotros), -áis/-éis/-ís (vosotros), -an/-en (ellos).",
      "-ar: hablo, hablas, habla, hablamos, habláis, hablan.",
      "-er/-ir fast gleich, nur wir/ihr unterscheiden sich: comemos/coméis, vivimos/vivís.",
      "Stammwechsel e->ie (querer -> quiero) und o->ue (poder -> puedo) — aber nie bei nosotros/vosotros: queremos, podemos.",
      "Unregelmäßige yo-Formen einfach lernen: tengo, hago, salgo, digo, estoy, soy, voy."
    ],
    "examples": [
      { "es": "Hablo español y trabajo en Madrid.", "de": "Ich spreche Spanisch und arbeite in Madrid." },
      { "es": "¿Vosotros coméis en casa?", "de": "Esst ihr zu Hause?" },
      { "es": "No puedo venir, no tengo tiempo.", "de": "Ich kann nicht kommen, ich habe keine Zeit." },
      { "es": "Ellos quieren un café.", "de": "Sie wollen einen Kaffee." }
    ]
  },
