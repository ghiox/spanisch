{
  "id": "pronombres",
  "title": "Objektpronomen",
  "rule": {
    "lines": [
      "Direktes Objekt (Wen? Was?): lo, la, los, las – Lo veo.",
      "Indirektes Objekt (Wem?): le, les – Le escribo.",
      "1. und 2. Person: direktes und indirektes Objekt sind gleich – me, te, nos, os.",
      "Stellung: vor dem konjugierten Verb (Te llamo) oder an den Infinitiv angehängt (Quiero llamarte).",
      "le/les + lo/la/los/las wird zu se: Se lo doy a Juan."
    ],
    "examples": [
      { "es": "Lo llama Ana.", "de": "Ana ruft ihn an." },
      { "es": "Le escribo un correo.", "de": "Ich schreibe ihm eine E-Mail." },
      { "es": "Quiero verte mañana.", "de": "Ich will dich morgen sehen." },
      { "es": "Se lo doy a Juan.", "de": "Ich gebe es Juan." }
    ]
  },
  "items": [
